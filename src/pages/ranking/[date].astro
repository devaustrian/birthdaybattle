---
import Layout from '../../layouts/Layout.astro';
const { date } = Astro.params;
---

<Layout title={`Ranking for ${date} - Birthday Battle`}>
  <main class="container mx-auto p-4">
    <h1 class="text-2xl font-bold mb-4">Ranking for {date}</h1>
    <div id="ranking-list" class="grid grid-cols-1 gap-4">
      <!-- Rankings will be populated by JavaScript -->
    </div>
  </main>
  <script>
    // Placeholder for fetching and displaying rankings
    document.addEventListener('DOMContentLoaded', () => {
      const rankingList = document.getElementById('ranking-list');
      rankingList.innerHTML = '<p>Loading rankings for ${date}...</p>';
      // Fetch rankings from API and render
    });
  </script>
</Layout>