---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin Panel - Birthday Battle">
  <main class="container mx-auto p-4">
    <h1 class="text-2xl font-bold mb-4">Admin Panel</h1>
    <div class="grid grid-cols-1 gap-4">
      <div>
        <h2 class="text-xl font-semibold">Add Candidate</h2>
        <input type="text" placeholder="Candidate Name" class="p-2 border rounded">
        <input type="date" class="p-2 border rounded">
        <button id="add-candidate" class="bg-green-500 text-white p-2 rounded hover:bg-green-600">Add</button>
      </div>
      <div>
        <h2 class="text-xl font-semibold">Remove Candidate</h2>
        <input type="text" placeholder="Candidate Name" class="p-2 border rounded">
        <button id="remove-candidate" class="bg-red-500 text-white p-2 rounded hover:bg-red-600">Remove</button>
      </div>
    </div>
  </main>
  <script>
    document.getElementById('add-candidate').addEventListener('click', () => {
      alert('Add candidate functionality to be implemented');
    });
    document.getElementById('remove-candidate').addEventListener('click', () => {
      alert('Remove candidate functionality to be implemented');
    });
  </script>
</Layout>