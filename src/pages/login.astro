---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Login - Birthday Battle">
  <main class="container mx-auto p-4">
    <h1 class="text-2xl font-bold mb-4">Login</h1>
    <div class="max-w-md mx-auto">
      <input type="text" placeholder="Username" class="w-full p-2 mb-2 border rounded">
      <input type="password" placeholder="Password" class="w-full p-2 mb-2 border rounded">
      <button id="login-button" class="bg-blue-500 text-white p-2 rounded hover:bg-blue-600 w-full">Login</button>
    </div>
  </main>
  <script>
    document.getElementById('login-button').addEventListener('click', () => {
      alert('Login functionality to be implemented');
    });
  </script>
</Layout>