---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Birthday Battle">
  <main class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-4">Welcome to Birthday Battle</h1>
    <p class="mb-4">Discover and vote for your favorite candidates each day!</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/calendar" class="bg-blue-500 text-white p-4 rounded hover:bg-blue-600">View Calendar</a>
      <a href="/login" class="bg-green-500 text-white p-4 rounded hover:bg-green-600">Login</a>
    </div>
  </main>
</Layout>